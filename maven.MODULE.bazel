maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

# Security-reviewed CodeArtifact allowlist. Do NOT add other endpoints — a new
# dependency-repository endpoint is a security-review finding (Phase 2). The last
# entry is this repo's own publish target (maven-snapshots) per the Phase-0 audit.
REPOSITORIES = [
    "https://confluent-524708692776.d.codeartifact.us-west-2.amazonaws.com/maven/confluent-maven/",
    "https://confluent-519856050701.d.codeartifact.us-west-2.amazonaws.com/maven/maven/",
    "https://packages.confluent.io/maven/",
    "https://confluent-519856050701.d.codeartifact.us-west-2.amazonaws.com/maven/maven-snapshots/",
]

maven.install(
    name = "maven",
    artifacts = [
        # --- compile scope ---
        "org.slf4j:slf4j-api:1.7.36",
        "org.slf4j:slf4j-reload4j:1.7.36",
        "ch.qos.reload4j:reload4j:1.2.26",
        "io.confluent:logredactor:1.0.18",
        "org.apache.logging.log4j:log4j-core:2.26.1",
        "com.google.guava:guava:32.1.3-jre",
        # Kafka connect-* come from the Maven property `kafka.version`, a RANGE
        # [8.5.0-0-0-ccs, 8.5.1-0-0-ccs). Pinned to the concrete latest-in-range
        # (8.5.0-102-ccs) so the lockfile is deterministic; Renovate/repin bumps
        # it. Recorded in the Phase-7 Handoff.
        "org.apache.kafka:connect-api:8.5.0-102-ccs",
        "org.apache.kafka:connect-json:8.5.0-102-ccs",
        # --- test scope (@maven is one resolver for the whole repo) ---
        "junit:junit:4.13.2",
        "org.mockito:mockito-core:4.11.0",
        "org.hamcrest:hamcrest-all:1.3",
        "javax.xml.bind:jaxb-api:2.3.1",
        # JUnit 5 platform + vintage engine (JUNIT5_VINTAGE_DEPS from
        # contrib_rules_jvm) to run this repo's JUnit 4 tests through the
        # platform. Versions come from the junit-bom below (repo property
        # junit.jupiter.version=5.14.4).
        "org.junit.jupiter:junit-jupiter-engine",
        "org.junit.platform:junit-platform-launcher",
        "org.junit.platform:junit-platform-reporting",
        "org.junit.vintage:junit-vintage-engine",
    ],
    boms = [
        "org.junit:junit-bom:5.14.4",
    ],
    fail_if_repin_required = True,
    fetch_sources = True,
    lock_file = "//:maven_install.json",
    repin_instructions = "REPIN=1 bazel run @maven//:pin",
    repositories = REPOSITORIES,
    resolve_timeout = 1800,
    use_credentials_from_home_netrc_file = True,
    version_conflict_policy = "pinned",
)
use_repo(maven, "maven")
