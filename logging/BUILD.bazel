load("//tools-bazel:library_wrappers.bzl", "java_export", "jvm_junit_test_suite")

java_export(
    name = "logging",
    srcs = glob(["src/main/java/**/*.java"]),
    maven_coordinates = "io.confluent:common-logging:$(maven_version)",
    visibility = ["//visibility:public"],
    deps = [
        # jackson is used directly (ObjectMapper / @JsonProperty / @JsonRawValue)
        # but comes transitively via connect-json under Maven — strict-deps needs
        # the explicit edge. Same 2.21.x Coursier resolved (common's depMgmt does
        # not pin jackson). See Phase-5 note on POM parity in skill-feedback.md.
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:com_fasterxml_jackson_core_jackson_core",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_google_guava_guava",
        "@maven//:org_apache_kafka_connect_api",
        "@maven//:org_apache_kafka_connect_json",
        "@maven//:org_slf4j_slf4j_api",
    ],
)

jvm_junit_test_suite(
    name = "logging-tests",
    srcs = glob(["src/test/java/**/*.java"]),
    runtime_deps = [
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
        "@maven//:org_junit_vintage_junit_vintage_engine",
    ],
    deps = [
        ":logging",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_google_guava_guava",
        "@maven//:junit_junit",
        "@maven//:org_apache_kafka_connect_api",
        "@maven//:org_hamcrest_hamcrest_all",
        "@maven//:org_mockito_mockito_core",
        "@maven//:org_slf4j_slf4j_api",
    ],
)
